{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hugo-native-client.local/schemas/manifest-v1.schema.json",
  "title": "Hugo Native Client manifest v1",
  "type": "object",
  "required": ["schemaVersion", "site", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "site": { "$ref": "#/$defs/site" },
    "navigation": { "type": "array", "items": { "$ref": "#/$defs/navigationItem" } },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "additionalProperties": true,
  "$defs": {
    "site": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "baseURL": { "type": "string", "format": "uri" },
        "defaultLanguage": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "chromeOmittedReason": { "type": "string" },
        "chrome": { "$ref": "#/$defs/siteChrome" }
      },
      "additionalProperties": true
    },
    "siteChrome": {
      "type": "object",
      "description": "Optional declarative site branding and links. Does not permit arbitrary HTML or scripts.",
      "properties": {
        "header": { "$ref": "#/$defs/chromeRegion" },
        "footer": { "$ref": "#/$defs/chromeRegion" }
      },
      "additionalProperties": true
    },
    "chromeRegion": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "logo": { "$ref": "#/$defs/assetReference" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "navigationItem": {
      "type": "object",
      "required": ["id", "label", "url"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" },
        "parent": { "type": ["string", "null"] },
        "weight": { "type": "integer" },
        "external": { "type": "boolean" },
        "menu": { "enum": ["main", "footer"] }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "path", "title", "rendering"],
      "properties": {
        "id": { "type": "string", "description": "Stable repository-relative content identity; normally the normalized sourcePath." },
        "sourcePath": { "type": "string" },
        "path": { "type": "string", "description": "Site-local URL path when the page belongs to baseURL; otherwise the resolved external URL." },
        "canonicalURL": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "draft": { "type": "boolean" },
        "section": { "type": "string" },
        "kind": { "type": "string" },
        "language": { "type": "string" },
        "taxonomies": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "rendering": { "$ref": "#/$defs/rendering" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "sourceDocument": { "$ref": "#/$defs/sourceDocument" },
        "contentFlow": { "type": "array", "items": { "$ref": "#/$defs/contentFlowItem" } }
      },
      "additionalProperties": true
    },
    "rendering": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["native", "web", "mixed"] },
        "fallbackURL": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sourceDocument": {
      "type": "object",
      "required": ["format", "rawSource", "bodyStartByte", "shortcodeTokens"],
      "properties": {
        "format": { "const": "hugo-markdown" },
        "rawSource": { "type": "string", "description": "Inert original source; never render or execute as HTML." },
        "bodyStartByte": { "type": "integer", "minimum": 0 },
        "roundTripPolicy": { "type": "string" },
        "shortcodeTokens": { "type": "array", "items": { "$ref": "#/$defs/shortcodeToken" } }
      },
      "additionalProperties": true
    },
    "shortcodeToken": {
      "type": "object",
      "required": ["type", "name", "syntax", "closing", "selfClosing", "raw", "parameters", "disposition", "sourceRange"],
      "properties": {
        "type": { "const": "shortcode" },
        "name": { "type": "string", "minLength": 1 },
        "syntax": { "enum": ["angle", "percent"] },
        "closing": { "type": "boolean" },
        "selfClosing": { "type": "boolean" },
        "raw": { "type": "string" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/shortcodeParameter" } },
        "disposition": { "enum": ["native", "text-fallback", "website-required"] },
        "sourceRange": { "$ref": "#/$defs/sourceRange" }
      },
      "additionalProperties": false
    },
    "shortcodeParameter": {
      "type": "object",
      "required": ["kind", "value", "raw"],
      "properties": {
        "kind": { "enum": ["named", "positional"] },
        "name": { "type": ["string", "null"] },
        "value": { "type": "string" },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sourceRange": {
      "type": "object",
      "required": ["startByte", "endByte", "startLine", "endLine"],
      "properties": {
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "contentFlowItem": {
      "oneOf": [
        { "type": "object", "required": ["type", "blocks"], "properties": { "type": { "const": "text" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "sourceRange": { "$ref": "#/$defs/sourceRange" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "name", "disposition", "readableChildren", "sourceRange"], "properties": { "type": { "const": "shortcode" }, "name": { "type": "string" }, "disposition": { "enum": ["native", "text-fallback", "website-required"] }, "readableChildren": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "sourceRange": { "$ref": "#/$defs/sourceRange" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "label", "href", "sourceRange"], "properties": { "type": { "const": "link" }, "label": { "type": "string" }, "href": { "type": "string" }, "inline": { "type": "boolean" }, "sourceRange": { "$ref": "#/$defs/sourceRange" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "title", "tone", "children", "sourceRange"], "properties": { "type": { "const": "callout" }, "title": { "type": "string" }, "tone": { "enum": ["note", "tip", "warning", "important"] }, "children": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "sourceRange": { "$ref": "#/$defs/sourceRange" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "items", "sourceRange"], "properties": { "type": { "const": "faq" }, "items": { "type": "array", "items": { "type": "object", "required": ["question", "answer", "sourceRange"], "properties": { "question": { "type": "string" }, "answer": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "sourceRange": { "$ref": "#/$defs/sourceRange" } }, "additionalProperties": false } }, "sourceRange": { "$ref": "#/$defs/sourceRange" } }, "additionalProperties": false }
      ]
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" },
        "inlines": { "type": "array", "items": { "$ref": "#/$defs/inline" } },
        "ordered": { "type": "boolean" },
        "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/block" } } },
        "src": { "$ref": "#/$defs/assetReference" },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "tone": { "enum": ["note", "tip", "warning", "important"] },
        "children": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "href": { "type": "string" },
        "language": { "type": "string" },
        "attribution": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inline": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "link", "emphasis", "strong", "code"] },
        "text": { "type": "string" },
        "href": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string" },
        "external": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "sourcePath": { "type": "string" },
        "path": { "type": "string" },
        "mediaType": { "type": "string" },
        "alt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "assetReference": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "alt": { "type": "string" },
            "mediaType": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
